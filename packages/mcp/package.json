{
  "name": "@prontiq/ariscan-mcp",
  "version": "0.35.24",
  "description": "MCP server exposing read-only ARI readiness data",
  "type": "module",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbejenar/prontiq-ariscan.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ariscan-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@prontiq/ariscan-engine": "workspace:*",
    "@prontiq/ariscan-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
