{
  "name": "@prontiq/ariscan-cli",
  "version": "0.11.0",
  "description": "Measure and improve repository readiness for AI coding agents",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbejenar/prontiq-ariscan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jbejenar/prontiq-ariscan/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/jbejenar/prontiq-ariscan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ariscan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "readiness",
    "score",
    "agentic",
    "codebase",
    "lint",
    "scan"
  ],
  "license": "Elastic-2.0",
  "dependencies": {
    "@prontiq/ariscan-engine": "workspace:*",
    "@prontiq/ariscan-schema": "workspace:*",
    "citty": "^0.2.1",
    "consola": "^3.4.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
