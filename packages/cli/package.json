{
  "name": "ariscan",
  "version": "0.1.0",
  "description": "Measure and improve repository readiness for AI coding agents",
  "type": "module",
  "bin": {
    "ariscan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "readiness",
    "score",
    "agentic",
    "codebase",
    "lint",
    "scan"
  ],
  "license": "MIT",
  "dependencies": {
    "@prontiq/engine": "workspace:*",
    "@prontiq/schema": "workspace:*",
    "citty": "^0.1.6",
    "consola": "^3.4.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
