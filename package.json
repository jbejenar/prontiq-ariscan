{
  "name": "prontiq-ariscan-monorepo",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "selftest": "node packages/cli/dist/cli.js . --threshold 70",
    "selftest:json": "node packages/cli/dist/cli.js . --json --threshold 70",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "doctor": "node --input-type=module -e \"import{execSync}from'child_process';const v=process.versions.node;const[M]=v.split('.');if(+M<22){console.error('Node >= 22 required, found '+v);process.exit(1)}console.log('Node '+v+' ✓');console.log('pnpm '+execSync('pnpm --version').toString().trim()+' ✓')\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "husky": "^9.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "turbo": "^2.8.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
